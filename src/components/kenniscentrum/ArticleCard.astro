---
import type { CollectionEntry } from 'astro:content';
import { formatDate, audienceLabels } from '@/lib/kenniscentrum';
import { dateIsSourceLastModified, hasOwnRelevance, STATUS_LABELS, OUTDATED_STATUSES } from '@/lib/news-presentation.mjs';

interface Props {
  article: CollectionEntry<'kenniscentrum'>;
  highlighted?: boolean;
}
const { article, highlighted = false } = Astro.props;
const { title, category, priority, publishedAt, summary, relevance, sourceName, audiences, tags, status } = article.data;
// Alleen een eigen duiding tonen; een sjabloonzin van de nieuwsengine niet.
const showRelevance = hasOwnRelevance(relevance);
const statusLabel = status ? STATUS_LABELS[status] : undefined;
const statusIsOutdated = status ? OUTDATED_STATUSES.has(status) : false;
// Bij de omgezette KVK-artikelen is de datum de "laatst gewijzigd"-datum van
// de bronpagina, geen publicatiedatum.
const dateIsLastModified = dateIsSourceLastModified(article.data);
---

<article
  class:list={['flex flex-col h-full border border-ink-200 p-6 transition-colors hover:border-brand-300', highlighted && 'border-brand-300']}
  data-category={category}
  data-source={sourceName}
  data-title={title.toLowerCase()}
  data-summary={summary.toLowerCase()}
  data-tags={tags.join(' ').toLowerCase()}
  data-audiences={audiences.join(' ')}
>
  <div class="flex items-center gap-2 flex-wrap">
    {statusLabel && (
      <span
        class:list={[
          'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold',
          statusIsOutdated ? 'bg-ink-100 text-ink-600' : 'border border-ink-300 bg-white text-ink-800',
        ]}
        data-status={status}
      >{statusLabel}</span>
    )}
    {priority === 'belangrijk' && !statusIsOutdated && (
      <span class="inline-flex items-center rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-semibold text-brand-700">Belangrijk</span>
    )}
    <span class="text-xs font-medium text-ink-500">{category}</span>
    <span class="text-xs text-ink-400">&middot;</span>
    <span class="text-xs text-ink-500">{dateIsLastModified && 'Bron bijgewerkt '}<time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time></span>
    <span
      class="audience-match-badge hidden ml-auto inline-flex items-center rounded-full bg-brand-600 px-2 py-0.5 text-[11px] font-semibold text-white"
      data-audience-badge
    >
      Relevant voor u
    </span>
  </div>

  <h3 class="mt-3 font-display text-lg font-semibold text-ink-900 leading-snug">
    <a href={`/kenniscentrum/${article.slug}`} class="hover:text-brand-600 transition-colors">
      {title}
    </a>
  </h3>

  <p class="mt-2 text-sm text-ink-600 leading-relaxed line-clamp-3">{summary}</p>

  {showRelevance && (
    <p class="mt-3 text-sm text-ink-700 leading-relaxed line-clamp-2">
      <span class="font-semibold text-ink-900">Wat betekent dit voor u?</span> {relevance}
    </p>
  )}

  {audiences.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {audiences.map((a) => (
        <span class="inline-flex items-center rounded-full bg-ink-50 px-2 py-0.5 text-[11px] font-medium text-ink-600">
          {audienceLabels[a] ?? a}
        </span>
      ))}
    </div>
  )}

  <div class="mt-4 pt-4 border-t border-ink-100 flex items-center justify-between gap-3">
    <span class="text-xs text-ink-500">Door Avydo &middot; bron: {sourceName}</span>
    <a href={`/kenniscentrum/${article.slug}`} class="inline-flex items-center gap-1 text-sm font-semibold text-brand-600 hover:gap-1.5 transition-all shrink-0">
      Lees meer
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.02-1.1l5 4.25a.75.75 0 0 1 0 1.18l-5 4.25a.75.75 0 1 1-1.02-1.1l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" /></svg>
    </a>
  </div>
</article>
