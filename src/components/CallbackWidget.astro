---
import { company } from '@/data/company';
---

<div class="card p-7 bg-ink-800 border-ink-800 text-white">
  <h3 class="font-display text-xl font-semibold text-white">Liever dat wij u bellen?</h3>
  <p class="mt-2 text-sm text-ink-200 leading-relaxed">Laat uw telefoonnummer achter en wij nemen contact met u op.</p>
  <form
    action={`mailto:${company.email}`}
    method="post"
    enctype="text/plain"
    class="mt-5 flex flex-col gap-3"
  >
    <label for="callback-phone" class="sr-only">Telefoonnummer</label>
    <input
      id="callback-phone"
      name="Terugbelverzoek - telefoonnummer"
      type="tel"
      required
      placeholder="Uw telefoonnummer"
      class="w-full rounded border border-ink-600 bg-ink-900/60 px-3.5 py-2.5 text-white placeholder:text-ink-400 focus:border-brand-400 focus:ring-1 focus:ring-brand-400 outline-none transition-colors"
    />
    <button type="submit" class="btn-primary">Bel mij terug</button>
  </form>
</div>
