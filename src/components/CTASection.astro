---
import { company } from '@/data/company';
interface Props {
  title?: string;
  intro?: string;
  showBrochure?: boolean;
}
const {
  title = 'Maak kennis met uw betrouwbare partner',
  intro = 'Bespreek vrijblijvend uw situatie met Avydo. U krijgt altijd een vast aanspreekpunt dat uw bedrijfsvoering écht kent.',
  showBrochure = true,
} = Astro.props;
---

<section class="border-t border-ink-100 bg-ink-950 text-white">
  <div class="container max-w-content py-20 md:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow text-brand-300">Aan de slag</p>
      <div class="mask-reveal mt-4 overflow-hidden" data-reveal="mask">
        <h2 class="mask-reveal-inner pb-2 font-display text-4xl font-semibold leading-[1.1] text-white sm:text-5xl">{title}</h2>
      </div>
      <p class="mt-5 max-w-lg leading-relaxed text-ink-200" data-reveal="fade" style="--stagger-delay:150ms">{intro}</p>
    </div>
    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-white/15 pt-8" data-reveal="fade" style="--stagger-delay:280ms">
      <a href="/contact" class="btn-primary">Maak een afspraak</a>
      <a href={company.phoneHref} class="link-draw text-sm font-semibold text-white">Bel {company.phone}</a>
      {showBrochure && (
        <a href="/downloads/avydo-brochure.pdf" target="_blank" rel="noopener noreferrer" class="link-draw text-sm font-semibold text-ink-300">
          Brochure bekijken
        </a>
      )}
    </div>
  </div>
</section>
