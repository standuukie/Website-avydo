---
interface Props {
  name: string;
  quote: string;
}
const { name, quote } = Astro.props;
---

<figure class="card p-7 flex flex-col h-full">
  <svg class="h-7 w-7 text-brand-300" viewBox="0 0 32 24" fill="currentColor" aria-hidden="true">
    <path d="M9.2 24c-2.6 0-4.7-.9-6.4-2.7C1.1 19.5.3 17.2.3 14.4c0-3 1-5.9 3-8.7C5.3 3 7.9.9 11 0l2.2 3.5c-2 .9-3.6 2-4.9 3.5C7 8.4 6.2 9.9 6 11.4c.5-.2 1.1-.3 1.8-.3 2 0 3.6.6 4.9 1.9 1.3 1.3 1.9 2.9 1.9 4.8 0 2-.7 3.6-2 4.9-1.3 1-2.8 1.3-3.4 1.3Zm18 0c-2.6 0-4.7-.9-6.4-2.7-1.7-1.8-2.5-4.1-2.5-6.9 0-3 1-5.9 3-8.7C23.3 3 25.9.9 29 0l2.2 3.5c-2 .9-3.6 2-4.9 3.5-1.3 1.4-2.1 2.9-2.3 4.4.5-.2 1.1-.3 1.8-.3 2 0 3.6.6 4.9 1.9 1.3 1.3 1.9 2.9 1.9 4.8 0 2-.7 3.6-2 4.9-1.3 1-2.8 1.3-3.4 1.3Z"/>
  </svg>
  <blockquote class="mt-4 text-ink-800 leading-relaxed flex-1">
    <p>&ldquo;{quote}&rdquo;</p>
  </blockquote>
  <figcaption class="mt-5 pt-5 border-t border-ink-100 text-sm font-semibold text-ink-900">{name}</figcaption>
</figure>
