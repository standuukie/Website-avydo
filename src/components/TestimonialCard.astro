---
interface Props {
  name: string;
  quote: string;
  logo: string;
  logoWidth: number;
  logoHeight: number;
}
const { name, quote, logo, logoWidth, logoHeight } = Astro.props;
---

<figure class="flex h-full flex-col border-t border-ink-200 pt-7">
  <blockquote class="flex-1 font-display text-xl font-semibold leading-snug text-ink-900">
    <p>&ldquo;{quote}&rdquo;</p>
  </blockquote>
  <figcaption class="mt-6 flex items-center gap-3">
    <img
      src={logo}
      alt={`Logo ${name}`}
      width={logoWidth}
      height={logoHeight}
      loading="lazy"
      class="h-8 max-w-[110px] w-auto object-contain"
    />
    <span class="text-sm font-semibold text-ink-700">{name}</span>
  </figcaption>
</figure>
