---
interface Props {
  name: string;
  quote: string;
  logo: string;
  logoWidth: number;
  logoHeight: number;
}
const { name, quote, logo, logoWidth, logoHeight } = Astro.props;
---

<figure class="card p-7 flex flex-col h-full">
  <div class="h-11 flex items-center">
    <img
      src={logo}
      alt={`Logo ${name}`}
      width={logoWidth}
      height={logoHeight}
      loading="lazy"
      class="max-h-11 max-w-[140px] w-auto h-auto object-contain"
    />
  </div>
  <blockquote class="mt-5 text-ink-800 leading-relaxed flex-1">
    <p>&ldquo;{quote}&rdquo;</p>
  </blockquote>
  <figcaption class="mt-5 pt-5 border-t border-ink-100 text-sm font-semibold text-ink-900">{name}</figcaption>
</figure>
