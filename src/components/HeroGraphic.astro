---
// Abstract editorial motif: layered ledger lines + an upward trend,
// evoking precision and steady growth without relying on stock photography.
---

<svg viewBox="0 0 480 480" class="w-full h-auto" role="img" aria-labelledby="hero-graphic-title">
  <title id="hero-graphic-title">Grafische weergave van financiële groei en overzicht</title>
  <defs>
    <linearGradient id="panel" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#3F3F45"/>
      <stop offset="100%" stop-color="#18181B"/>
    </linearGradient>
  </defs>
  <rect x="16" y="16" width="448" height="448" rx="14" fill="url(#panel)"/>
  <g stroke="#56565C" stroke-width="1">
    <line x1="16" y1="128" x2="464" y2="128"/>
    <line x1="16" y1="240" x2="464" y2="240"/>
    <line x1="16" y1="352" x2="464" y2="352"/>
  </g>
  <g stroke="#DC4B54" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="56,360 140,320 200,340 260,240 320,260 400,140" />
  </g>
  <g fill="#DC4B54">
    <circle cx="56" cy="360" r="5"/>
    <circle cx="140" cy="320" r="5"/>
    <circle cx="200" cy="340" r="5"/>
    <circle cx="260" cy="240" r="5"/>
    <circle cx="320" cy="260" r="5"/>
    <circle cx="400" cy="140" r="6"/>
  </g>
  <g fill="#9C9CA3" opacity="0.9">
    <rect x="56" y="392" width="18" height="40" rx="2"/>
    <rect x="140" y="374" width="18" height="58" rx="2"/>
    <rect x="200" y="384" width="18" height="48" rx="2"/>
    <rect x="260" y="356" width="18" height="76" rx="2"/>
    <rect x="320" y="366" width="18" height="66" rx="2"/>
    <rect x="380" y="330" width="18" height="102" rx="2"/>
  </g>
  <rect x="16" y="16" width="448" height="448" rx="14" fill="none" stroke="#75757C" stroke-width="1"/>
</svg>
