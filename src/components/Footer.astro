---
import { footerNav } from '@/data/nav';
import { company } from '@/data/company';

const year = new Date().getFullYear();
---

<footer class="bg-paper-muted border-t border-ink-200">
  <div class="container max-w-content py-14 grid gap-10 md:grid-cols-2 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <a href="/" class="inline-flex items-center">
        <img
          src="/images/avydo-logo.png"
          alt="Avydo Accountants & Belastingadviseurs"
          width="227"
          height="75"
          class="h-11 w-auto"
          loading="lazy"
        />
      </a>
      <p class="mt-4 text-sm leading-relaxed text-ink-600 max-w-sm">
        Uw partner in bedrijfsvoering in Venray en omstreken. Sinds 2006 begeleiden wij mkb-ondernemers met accountancy, belastingadvies en loonadministratie.
      </p>
      <address class="mt-5 not-italic text-sm leading-relaxed text-ink-600">
        {company.address.street}<br />
        {company.address.postalCode} {company.address.city}
      </address>
      <div class="mt-4 flex flex-col gap-1.5 text-sm">
        <a href={company.phoneHref} class="text-ink-600 hover:text-brand-600 transition-colors">{company.phone}</a>
        <a href={`mailto:${company.email}`} class="text-ink-600 hover:text-brand-600 transition-colors">{company.email}</a>
      </div>
    </div>

    {footerNav.map((col) => (
      <div>
        <h3 class="text-ink-900 font-semibold text-sm tracking-wide uppercase mb-4">{col.heading}</h3>
        <ul class="space-y-2.5">
          {col.links.map((link) => (
            <li><a href={link.href} class="text-sm text-ink-600 hover:text-brand-600 transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="border-t border-ink-200">
    <div class="container max-w-content py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-ink-600">
      <p>&copy; {year} {company.name}. Alle rechten voorbehouden.</p>
      <p>KvK-gegevens en beroepsregistratie op aanvraag beschikbaar via {company.email}.</p>
    </div>
  </div>
</footer>
