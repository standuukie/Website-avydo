---
import type { TeamMember } from '@/data/team';
interface Props { member: TeamMember }
const { member } = Astro.props;
---

<div class="card p-7 flex flex-col sm:flex-row gap-5">
  <img
    src={member.photo}
    alt={member.name}
    width="320"
    height="480"
    class="w-28 sm:w-32 h-auto aspect-[2/3] rounded-md object-cover object-top shrink-0 border border-ink-100"
    loading="lazy"
  />
  <div>
    <h3 class="font-display text-lg font-semibold text-ink-900">{member.name}</h3>
    <p class="text-sm text-brand-600 font-medium">{member.role}</p>
    <div class="mt-4 space-y-3 text-sm text-ink-600 leading-relaxed">
      {member.bio.map((p) => <p>{p}</p>)}
    </div>
  </div>
</div>
