---
interface Crumb { label: string; href?: string }
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, intro, crumbs } = Astro.props;
---

<section class="bg-navy-900 text-white">
  <div class="container max-w-content py-14 md:py-20">
    {crumbs && crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-1.5 text-xs text-navy-300">
          <li><a href="/" class="hover:text-white">Home</a></li>
          {crumbs.map((c) => (
            <>
              <li aria-hidden="true">/</li>
              <li>{c.href ? <a href={c.href} class="hover:text-white">{c.label}</a> : <span class="text-white">{c.label}</span>}</li>
            </>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow text-copper-400">{eyebrow}</p>}
    <h1 class="mt-3 text-3xl md:text-5xl font-display font-semibold text-white max-w-3xl leading-tight">{title}</h1>
    {intro && <p class="mt-5 text-navy-200 max-w-2xl text-lg leading-relaxed">{intro}</p>}
  </div>
</section>
