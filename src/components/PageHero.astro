---
interface Crumb { label: string; href?: string }
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, intro, crumbs } = Astro.props;
---

<section class="bg-ink-950 text-white">
  <div class="container max-w-content py-16 md:py-24">
    {crumbs && crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-7">
        <ol class="flex flex-wrap items-center gap-1.5 text-xs text-ink-300">
          <li><a href="/" class="hover:text-white">Home</a></li>
          {crumbs.map((c) => (
            <>
              <li aria-hidden="true">/</li>
              <li>{c.href ? <a href={c.href} class="hover:text-white">{c.label}</a> : <span class="text-white">{c.label}</span>}</li>
            </>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow text-brand-500 motion-safe:animate-fade-up">{eyebrow}</p>}
    <div class="mask-reveal mt-4 overflow-hidden" data-reveal="mask">
      <h1 class="mask-reveal-inner max-w-3xl pb-2 font-display text-4xl font-semibold leading-[1.1] text-white sm:text-5xl md:text-6xl">{title}</h1>
    </div>
    {intro && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-200 motion-safe:animate-fade-up [animation-delay:200ms]">{intro}</p>}
  </div>
</section>
