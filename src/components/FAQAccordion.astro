---
interface FAQItem { question: string; answer: string }
interface Props { items: FAQItem[] }
const { items } = Astro.props;
---

<div class="divide-y divide-ink-100 border-t border-b border-ink-100">
  {items.map((item) => (
    <details class="group py-5" name="faq">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left">
        <span class="font-display text-lg font-medium text-ink-900">{item.question}</span>
        <svg class="h-5 w-5 shrink-0 text-brand-500 transition-transform duration-200 group-open:rotate-45" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10 3a.75.75 0 0 1 .75.75v5.5h5.5a.75.75 0 0 1 0 1.5h-5.5v5.5a.75.75 0 0 1-1.5 0v-5.5h-5.5a.75.75 0 0 1 0-1.5h5.5v-5.5A.75.75 0 0 1 10 3Z" />
        </svg>
      </summary>
      <p class="mt-3 text-ink-600 leading-relaxed max-w-3xl">{item.answer}</p>
    </details>
  ))}
</div>
