---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CTASection from '@/components/CTASection.astro';
import { company } from '@/data/company';
---

<BaseLayout
  title="Geschiedenis"
  description="Avydo is op 1 juli 2006 opgericht door René Duijkers en Eric Verbaandert. Lees hoe het kantoor uitgroeide tot regionale partner in bedrijfsvoering."
  path="/over-ons/geschiedenis"
>
  <PageHero
    eyebrow="Over Avydo"
    title="De geschiedenis van Avydo"
    intro="Avydo is via een overname opgericht op 1 juli 2006. In deze relatief korte bedrijfsgeschiedenis heeft Avydo zich sterk ontwikkeld."
    crumbs={[{ label: 'Over Avydo', href: '/over-ons' }, { label: 'Geschiedenis' }]}
  />

  <section class="section">
    <div class="container max-w-content">
      <div class="max-w-3xl space-y-5 text-ink-700 leading-relaxed text-lg">
        <p>
          In de zomer van {company.foundedYear} hebben {company.founders.join(' en ')} Avydo opgericht na een overname. Door het aanbieden van een &lsquo;full-serviceconcept&rsquo; heeft Avydo zich sterk in de regionale markt gevestigd. In eerste instantie richtte Avydo zich op de regio Venray, Horst en Nieuw-Bergen met hun kerkdorpen.
        </p>
        <p>
          Waar veel concurrenten bleven hangen in de achterhaalde accountantgedachte, is Avydo meegegaan met de groeiende vraag naar advies van klanten. Door de nadruk te leggen op advisering heeft Avydo een sterke klantenkring opgebouwd. Ondernemers werken graag vanuit hun vakmanschap, en het is mooi dat Avydo hen daarin als vakman mag begeleiden.
        </p>
        <p class="text-ink-500 italic">Meer geschiedenis wordt geschreven&hellip;</p>
      </div>

      <div class="relative mt-14 max-w-2xl pt-2">
        <div class="spine-line absolute bottom-2 left-[0.6rem] top-2 w-px bg-ink-200 sm:left-[0.9rem]" data-reveal="spine" aria-hidden="true"></div>
        <div class="space-y-12">
          <div class="relative pl-10 sm:pl-14" data-reveal="spine-step">
            <span class="spine-dot absolute left-0 top-1 h-5 w-5 rounded-full border-2 border-ink-300 bg-white sm:h-7 sm:w-7"></span>
            <span class="font-display text-2xl font-semibold text-brand-600">{company.foundedYear}</span>
            <p class="mt-2 text-ink-600 leading-relaxed max-w-xl">
              Oprichting van Avydo Accountants &amp; Belastingadviseurs door {company.founders.join(' en ')}, via overname van een bestaande praktijk in Venray.
            </p>
          </div>
          <div class="relative pl-10 sm:pl-14" data-reveal="spine-step" style="--stagger-delay:150ms">
            <span class="spine-dot absolute left-0 top-1 h-5 w-5 rounded-full border-2 border-ink-300 bg-white sm:h-7 sm:w-7"></span>
            <span class="font-display text-2xl font-semibold text-brand-600">2017</span>
            <p class="mt-2 text-ink-600 leading-relaxed max-w-xl">
              De NBA voert een kwaliteitstoetsing uit bij Avydo. Conclusie: Avydo voldoet aan de hoge eisen van de Wet op het accountantsberoep.
            </p>
          </div>
          <div class="relative pl-10 sm:pl-14" data-reveal="spine-step" style="--stagger-delay:300ms">
            <span class="spine-dot absolute left-0 top-1 h-5 w-5 rounded-full border-2 border-ink-300 bg-white sm:h-7 sm:w-7"></span>
            <span class="font-display text-2xl font-semibold text-ink-900">Vandaag</span>
            <p class="mt-2 text-ink-600 leading-relaxed max-w-xl">
              Avydo begeleidt mkb-ondernemers in de regio Venray, Vierlingsbeek, Horst-Sevenum en Nieuw-Bergen met een team van {company.teamSize}.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-ink-950" data-reveal="fade">
    <img
      src="/images/avydo-gebouw.jpg"
      alt="Het pand van Avydo Accountants & Belastingadviseurs aan het Keizersveld in Venray"
      width="1758"
      height="1114"
      loading="lazy"
      class="h-[38vh] w-full object-cover object-[60%_40%] sm:h-[46vh]"
    />
  </section>

  <CTASection />
</BaseLayout>
