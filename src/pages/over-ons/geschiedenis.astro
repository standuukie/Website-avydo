---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CTASection from '@/components/CTASection.astro';
import { company } from '@/data/company';
---

<BaseLayout
  title="Geschiedenis"
  description="Avydo is op 1 juli 2006 opgericht door René Duijkers en Eric Verbaandert. Lees hoe het kantoor uitgroeide tot regionale partner in bedrijfsvoering."
  path="/over-ons/geschiedenis"
>
  <PageHero
    eyebrow="Over Avydo"
    title="De geschiedenis van Avydo"
    intro="Avydo is via een overname opgericht op 1 juli 2006. In deze relatief korte bedrijfsgeschiedenis heeft Avydo zich sterk ontwikkeld."
    crumbs={[{ label: 'Over Avydo', href: '/over-ons' }, { label: 'Geschiedenis' }]}
  />

  <section class="section">
    <div class="container max-w-content">
      <div class="max-w-3xl space-y-5 text-navy-700 leading-relaxed text-lg">
        <p>
          In de zomer van {company.foundedYear} hebben {company.founders.join(' en ')} Avydo opgericht na een overname. Door het aanbieden van een &lsquo;full-serviceconcept&rsquo; heeft Avydo zich sterk in de regionale markt gevestigd. In eerste instantie richtte Avydo zich op de regio Venray, Horst en Nieuw-Bergen met hun kerkdorpen.
        </p>
        <p>
          Waar veel concurrenten bleven hangen in de achterhaalde accountantgedachte, is Avydo meegegaan met de groeiende vraag naar advies van klanten. Door de nadruk te leggen op advisering heeft Avydo een sterke klantenkring opgebouwd. Ondernemers werken graag vanuit hun vakmanschap, en het is mooi dat Avydo hen daarin als vakman mag begeleiden.
        </p>
        <p class="text-navy-500 italic">Meer geschiedenis wordt geschreven&hellip;</p>
      </div>

      <div class="mt-14 border-t border-navy-100 pt-10">
        <div class="flex gap-6">
          <div class="hidden sm:flex flex-col items-center pt-1">
            <span class="h-3 w-3 rounded-full bg-copper-500"></span>
            <span class="w-px flex-1 bg-navy-200 mt-2"></span>
          </div>
          <div>
            <span class="font-display text-xl font-semibold text-navy-900">{company.foundedYear}</span>
            <p class="mt-1 text-navy-600 leading-relaxed max-w-xl">
              Oprichting van Avydo Accountants &amp; Belastingadviseurs door {company.founders.join(' en ')}, via overname van een bestaande praktijk in Venray.
            </p>
          </div>
        </div>
        <div class="flex gap-6 mt-8">
          <div class="hidden sm:flex flex-col items-center pt-1">
            <span class="h-3 w-3 rounded-full bg-copper-500"></span>
            <span class="w-px flex-1 bg-navy-200 mt-2"></span>
          </div>
          <div>
            <span class="font-display text-xl font-semibold text-navy-900">2017</span>
            <p class="mt-1 text-navy-600 leading-relaxed max-w-xl">
              De NBA voert een kwaliteitstoetsing uit bij Avydo. Conclusie: Avydo voldoet aan de hoge eisen van de Wet op het accountantsberoep.
            </p>
          </div>
        </div>
        <div class="flex gap-6 mt-8">
          <div class="hidden sm:flex flex-col items-center pt-1">
            <span class="h-3 w-3 rounded-full bg-navy-300"></span>
          </div>
          <div>
            <span class="font-display text-xl font-semibold text-navy-900">Vandaag</span>
            <p class="mt-1 text-navy-600 leading-relaxed max-w-xl">
              Avydo begeleidt mkb-ondernemers in de regio Venray, Vierlingsbeek, Horst-Sevenum en Nieuw-Bergen met een team van {company.teamSize}.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
