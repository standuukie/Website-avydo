---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CTASection from '@/components/CTASection.astro';
import { company } from '@/data/company';
---

<BaseLayout
  title="Over Avydo"
  description="Avydo Accountants & Belastingadviseurs is een adviesorganisatie voor het mkb, opgericht in 2006. Lees onze visie op moderne accountancy."
  path="/over-ons"
>
  <PageHero
    eyebrow="Over Avydo"
    title="De moderne accountant is een sterke adviseur"
    intro="Waar accountants voorheen vooral een administratieve functie vervulden, hebben ondernemers tegenwoordig behoefte aan een sterke adviseur naast zich. Avydo herkent dit en pakt het aan."
    crumbs={[{ label: 'Over Avydo' }]}
  />

  <section class="section">
    <div class="container max-w-content grid lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 space-y-5 text-ink-700 leading-relaxed text-lg">
        <p>
          Avydo Accountants en Belastingadviseurs is een adviesorganisatie voor het mkb op het gebied van accountancy, belastingadvies en loonadministratie. Avydo is in {company.founded} opgericht door {company.founders.join(' en ')}. Avydo stelt zich ten doel een sterke vertrouwensband aan te gaan, wat de basis is voor een succesvolle samenwerking.
        </p>
        <p>
          Avydo heeft voldoende ervaring en kennis in huis om ondernemers bij te staan. Juist in economisch mindere tijden moet u als ondernemer kunnen terugvallen op het vakmanschap van uw accountant. Avydo is ervan overtuigd dezelfde kwaliteit te kunnen bieden als grotere accountantskantoren, met als kleiner kantoor een gunstigere prijsstelling.
        </p>
        <p>
          Als ondernemer/accountant weet Avydo zelf goed wat er binnen een onderneming kan spelen. Daarom mag u advies verwachten vanuit een ondernemerspositie. Met {company.teamSize} is Avydo meer dan een accountant: Avydo is een betrouwbare partner in ondernemerschap.
        </p>
      </div>

      <aside>
        <div class="card p-6 bg-ink-50/60">
          <h3 class="font-display text-lg font-semibold text-ink-900">In het kort</h3>
          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex justify-between gap-4"><dt class="text-ink-600">Opgericht</dt><dd class="font-semibold text-ink-900">{company.founded}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-ink-600">Oprichters</dt><dd class="font-semibold text-ink-900 text-right">{company.founders.join(', ')}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-ink-600">Team</dt><dd class="font-semibold text-ink-900">{company.teamSize}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-ink-600">Getoetst door</dt><dd class="font-semibold text-ink-900">NBA (2017)</dd></div>
          </dl>
          <a href="/over-ons/team" class="btn-outline mt-6 w-full">Maak kennis met het team</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-ink-950" data-reveal="fade">
    <img
      src="/images/avydo-gebouw.jpg"
      alt="Het pand van Avydo Accountants & Belastingadviseurs aan het Keizersveld in Venray"
      width="1758"
      height="1114"
      loading="lazy"
      class="h-[42vh] w-full object-cover object-[45%_45%] sm:h-[52vh]"
    />
  </section>

  <section class="section bg-ink-950 text-white">
    <div class="container max-w-content grid lg:grid-cols-3 gap-10 items-start">
      <div>
        <p class="eyebrow text-brand-300">Kwaliteitsborging</p>
        <div class="mask-reveal mt-3 overflow-hidden" data-reveal="mask">
          <h2 class="mask-reveal-inner pb-1 font-display text-2xl font-semibold leading-[1.1] text-white">Beoordeeld door de NBA</h2>
        </div>
      </div>
      <div class="lg:col-span-2 space-y-4 text-ink-200 leading-relaxed">
        <p>
          In december 2017 heeft de Koninklijke Nederlandse Beroepsorganisatie van Accountants (NBA) een kwaliteitstoetsing verricht bij Avydo. Zeer ervaren accountants/toetsers van andere accountantskantoren hebben onderzoek ingesteld naar het stelsel van kwaliteitsbeheersing binnen Avydo.
        </p>
        <p>
          De onderzoekers concludeerden dat Avydo voldoet aan de hoge kwaliteitseisen van de Wet op het accountantsberoep. Medeoprichter René Duijkers: &ldquo;Dit is een waardevolle bevestiging van de kwaliteit van onze dienstverlening. Daarnaast biedt het ruimte voor nieuwe uitdagingen.&rdquo;
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container max-w-content">
      <div class="border-t border-ink-200">
        {[
          { href: '/over-ons/team', title: 'Team', text: 'Maak kennis met onze partners en het team achter Avydo.' },
          { href: '/over-ons/geschiedenis', title: 'Geschiedenis', text: 'Van overname in 2006 tot regionale full-service partner.' },
          { href: '/over-ons/mvo', title: 'Maatschappelijke betrokkenheid', text: 'Sponsoring en de ontwikkeling van studenten in de regio Venray.' },
        ].map((item, i) => (
          <a href={item.href} class="group flex flex-col gap-2 border-b border-ink-200 py-7 sm:flex-row sm:items-center sm:justify-between sm:gap-8" data-reveal="fade" style={`--stagger-delay:${i * 100}ms`}>
            <div>
              <h3 class="font-display text-xl font-semibold text-ink-900 transition-colors group-hover:text-brand-600">{item.title}</h3>
              <p class="mt-1 max-w-xl text-sm leading-relaxed text-ink-600">{item.text}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
