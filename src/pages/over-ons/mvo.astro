---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CTASection from '@/components/CTASection.astro';
import { sponsorships, mvoIntro } from '@/data/mvo';
import { internships } from '@/data/jobs';
import { company } from '@/data/company';
---

<BaseLayout
  title="Maatschappelijke betrokkenheid"
  description="Avydo geeft invulling aan maatschappelijk verantwoord ondernemen via sponsoring van regionale sportverenigingen en het begeleiden van studenten."
  path="/over-ons/mvo"
>
  <PageHero
    eyebrow="Over Avydo"
    title="Maatschappelijk verantwoord ondernemen"
    intro={mvoIntro}
    crumbs={[{ label: 'Over Avydo', href: '/over-ons' }, { label: 'Maatschappelijke betrokkenheid' }]}
  />

  <section class="section">
    <div class="container max-w-content">
      <p class="eyebrow">Sponsoring</p>
      <h2 class="mt-3 text-2xl font-display font-semibold text-ink-900">Verbonden met sportverenigingen in Venray en omstreken</h2>
      <div class="mt-8 grid md:grid-cols-3 gap-6">
        {sponsorships.map((s) => (
          <div class="card p-7">
            <div class="flex items-center gap-4">
              <img
                src={s.logo}
                alt={`Logo ${s.name}`}
                width={s.logoWidth}
                height={s.logoHeight}
                loading="lazy"
                class="h-14 w-14 shrink-0 rounded border border-ink-100 object-contain bg-white"
              />
              <h3 class="font-display text-lg font-semibold text-ink-900">{s.name}</h3>
            </div>
            <p class="mt-4 text-sm text-ink-600 leading-relaxed">{s.description}</p>
            <a href={s.website} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:underline">
              Website bezoeken
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M4.5 4A1.5 1.5 0 0 0 3 5.5v10A1.5 1.5 0 0 0 4.5 17h10a1.5 1.5 0 0 0 1.5-1.5V11a.75.75 0 0 0-1.5 0v4.5h-10v-10H9A.75.75 0 0 0 9 4H4.5Zm6.75.75c0 .414.336.75.75.75h2.69l-6.22 6.22a.75.75 0 1 0 1.06 1.06l6.22-6.22v2.69a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0-.75.75Z"/></svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-ink-50/60 border-y border-ink-100">
    <div class="container max-w-content grid lg:grid-cols-3 gap-10">
      <div>
        <p class="eyebrow">Studenten</p>
        <h2 class="mt-3 text-2xl font-display font-semibold text-ink-900">Ruimte voor talent</h2>
      </div>
      <div class="lg:col-span-2">
        <p class="text-ink-600 leading-relaxed">{internships.intro}</p>
        <p class="mt-4 text-sm font-semibold text-ink-800">In het verleden werkte Avydo samen met:</p>
        <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {internships.partners.map((p) => (
            <a
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              class="card group flex flex-col items-center text-center p-6 hover:shadow-card-hover hover:-translate-y-0.5 transition-all duration-200"
            >
              <span class="flex h-12 w-full items-center justify-center">
                <img
                  src={p.logo}
                  alt=""
                  width={p.logoWidth}
                  height={p.logoHeight}
                  loading="lazy"
                  class="max-h-12 w-auto object-contain"
                />
              </span>
              <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-brand-600">
                {p.institution}{p.location ? `, ${p.location}` : ''}
              </p>
              <h3 class="mt-1.5 font-display text-base font-semibold text-ink-900">{p.name}</h3>
              <span class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-ink-500 group-hover:text-brand-600 group-hover:gap-2.5 transition-all">
                Opleidingspagina
                <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M4.5 4A1.5 1.5 0 0 0 3 5.5v10A1.5 1.5 0 0 0 4.5 17h10a1.5 1.5 0 0 0 1.5-1.5V11a.75.75 0 0 0-1.5 0v4.5h-10v-10H9A.75.75 0 0 0 9 4H4.5Zm6.75.75c0 .414.336.75.75.75h2.69l-6.22 6.22a.75.75 0 1 0 1.06 1.06l6.22-6.22v2.69a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0-.75.75Z"/></svg>
              </span>
            </a>
          ))}
        </div>
        <a href={`mailto:${company.email}`} class="btn-outline mt-6">Stuur je motivatie en cv</a>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
