---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import TeamMemberCard from '@/components/TeamMemberCard.astro';
import CTASection from '@/components/CTASection.astro';
import { partners, teamIntro } from '@/data/team';
---

<BaseLayout
  title="Team"
  description="Maak kennis met de partners van Avydo, René Duijkers en Eric Verbaandert, en het team van tien professionals in Venray."
  path="/over-ons/team"
>
  <PageHero
    eyebrow="Over Avydo"
    title="Teamwork is de basis voor een goed resultaat"
    intro={teamIntro}
    crumbs={[{ label: 'Over Avydo', href: '/over-ons' }, { label: 'Team' }]}
  />

  <section class="section">
    <div class="container max-w-content">
      <p class="eyebrow">Partners</p>
      <div class="mask-reveal mt-3 overflow-hidden" data-reveal="mask">
        <h2 class="mask-reveal-inner pb-1 font-display text-2xl font-semibold leading-[1.1] text-ink-900 sm:text-3xl">
          Avydo staat vanaf de oprichting onder leiding van twee partners
        </h2>
      </div>
      <div class="mt-10 grid md:grid-cols-2 gap-x-10 gap-y-10">
        {partners.map((member) => <TeamMemberCard member={member} />)}
      </div>
    </div>
  </section>

  <section class="section bg-paper-muted border-y border-ink-100">
    <div class="container max-w-content">
      <div class="max-w-3xl text-center mx-auto">
        <h2 class="font-display text-2xl font-semibold leading-[1.1] text-ink-900 sm:text-3xl">Een team van tien professionals</h2>
        <p class="mt-4 text-ink-600 leading-relaxed">
          Naast de partners bestaat het Avydo-team uit medewerkers verdeeld over de afdelingen accountancy, belastingadvies, loonadministratie en het secretariaat. Door de nauwe samenwerking profiteren onze professionals van elkaars expertise, zodat u als klant altijd op de juiste kennis kunt rekenen.
        </p>
      </div>
    </div>
  </section>

  <CTASection title="Maak kennis met ons team" intro="Plan een vrijblijvend kennismakingsgesprek en ontdek hoe wij u kunnen ondersteunen." />
</BaseLayout>
