---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import VideoCard from '@/components/VideoCard.astro';
import CTASection from '@/components/CTASection.astro';
import { services, additionalServices } from '@/data/services';
import { introVideos } from '@/data/videos';

const arrow = '<svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.02-1.1l5 4.25a.75.75 0 0 1 0 1.18l-5 4.25a.75.75 0 1 1-1.02-1.1l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" /></svg>';
---

<BaseLayout
  title="Diensten"
  description="Ontdek de diensten van Avydo: accountancy, belastingadvies en loonadministratie voor mkb-ondernemers in Venray en omgeving."
  path="/diensten"
>
  <PageHero
    eyebrow="Diensten"
    title="Een compleet dienstenpakket voor uw onderneming"
    intro="Avydo biedt drie basisdiensten: accountancy, belastingadvies en loonadministratie, aangevuld met kennis en ondersteuning die uw bedrijfsvoering versterken."
    crumbs={[{ label: 'Diensten' }]}
  />

  <section class="section">
    <div class="container max-w-content">
      <div class="border-t border-ink-200">
        {services.map((service, i) => (
          <a
            href={`/diensten/${service.slug}`}
            class="index-row group relative block border-b border-ink-200 py-8 transition-colors md:py-10"
            data-reveal="index-row"
            style={`--stagger-delay:${i * 130}ms`}
          >
            <div class="grid items-baseline gap-x-6 gap-y-3 md:grid-cols-12">
              <span class="font-display text-sm text-ink-400 md:col-span-1">{String(i + 1).padStart(2, '0')}</span>
              <span class="index-row-name block font-display text-4xl font-semibold text-ink-900 transition-colors duration-300 group-hover:text-brand-600 sm:text-5xl md:col-span-6 md:text-6xl">
                {service.name}
              </span>
              <p class="text-ink-600 leading-relaxed md:col-span-5">{service.short}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-paper-muted border-y border-ink-100">
    <div class="container max-w-content">
      <div class="max-w-2xl">
        <p class="eyebrow">Kennismaking</p>
        <div class="mask-reveal mt-4 overflow-hidden" data-reveal="mask">
          <h2 class="mask-reveal-inner pb-1 font-display text-3xl font-semibold leading-[1.1] text-ink-900 sm:text-4xl">Maak kennis met uw adviseurs</h2>
        </div>
        <p class="mt-4 text-ink-600 leading-relaxed">
          Voordat u een afspraak maakt, kunt u hier alvast kennismaken met René Duijkers en Eric Verbaandert.
        </p>
      </div>
      <div class="mt-10 grid sm:grid-cols-2 gap-6" data-reveal="fade">
        {introVideos.map((video) => <VideoCard video={video} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container max-w-content">
      <div class="max-w-2xl">
        <p class="eyebrow">Meer dan de basis</p>
        <div class="mask-reveal mt-4 overflow-hidden" data-reveal="mask">
          <h2 class="mask-reveal-inner pb-1 font-display text-3xl font-semibold leading-[1.1] text-ink-900 sm:text-4xl">Aanvullende diensten</h2>
        </div>
        <p class="mt-4 text-ink-600 leading-relaxed">{additionalServices.intro}</p>
      </div>
      <div class="mt-10 border-t border-ink-200">
        {additionalServices.items.map((item, i) => (
          <a href={item.href} class="group flex flex-col gap-3 border-b border-ink-200 py-7 sm:flex-row sm:items-center sm:justify-between sm:gap-8" data-reveal="fade" style={`--stagger-delay:${i * 100}ms`}>
            <div>
              <h3 class="font-display text-xl font-semibold text-ink-900 transition-colors group-hover:text-brand-600">{item.title}</h3>
              <p class="mt-1.5 max-w-xl text-sm leading-relaxed text-ink-600">{item.description}</p>
            </div>
            <span class="link-draw inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-brand-600">
              {item.linkLabel}
              <Fragment set:html={arrow} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
