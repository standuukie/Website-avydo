---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CTASection from '@/components/CTASection.astro';
import { services, additionalServices } from '@/data/services';
---

<BaseLayout
  title="Diensten"
  description="Ontdek de diensten van Avydo: accountancy, belastingadvies en loonadministratie voor mkb-ondernemers in Venray en omgeving."
  path="/diensten"
>
  <PageHero
    eyebrow="Diensten"
    title="Een compleet dienstenpakket voor uw onderneming"
    intro="Avydo biedt drie basisdiensten &mdash; accountancy, belastingadvies en loonadministratie &mdash; aangevuld met kennis en ondersteuning die uw bedrijfsvoering versterken."
    crumbs={[{ label: 'Diensten' }]}
  />

  <section class="section">
    <div class="container max-w-content grid md:grid-cols-3 gap-6">
      {services.map((service, i) => (
        <ServiceCard name={service.name} description={service.short} href={`/diensten/${service.slug}`} index={i} />
      ))}
    </div>
  </section>

  <section class="section bg-navy-50/60 border-y border-navy-100">
    <div class="container max-w-content">
      <div class="max-w-2xl">
        <p class="eyebrow">Meer dan de basis</p>
        <h2 class="mt-3 text-3xl font-display font-semibold text-navy-900">Aanvullende diensten</h2>
        <p class="mt-4 text-navy-600 leading-relaxed">{additionalServices.intro}</p>
      </div>
      <div class="mt-10 grid sm:grid-cols-2 gap-6">
        {additionalServices.items.map((item) => (
          <div class="card p-7">
            <h3 class="font-display text-lg font-semibold text-navy-900">{item.title}</h3>
            <p class="mt-2 text-sm text-navy-600 leading-relaxed">{item.description}</p>
            <a href={item.href} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-copper-600 hover:gap-2.5 transition-all">
              {item.linkLabel}
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.02-1.1l5 4.25a.75.75 0 0 1 0 1.18l-5 4.25a.75.75 0 1 1-1.02-1.1l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" /></svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
