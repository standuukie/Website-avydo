---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CTASection from '@/components/CTASection.astro';
import { additionalServices } from '@/data/services';
---

<BaseLayout
  title="Aanvullende diensten"
  description="Naast accountancy, belastingadvies en loonadministratie biedt Avydo een kenniscentrum en een persoonlijk secretariaat."
  path="/diensten/aanvullende-diensten"
>
  <PageHero
    eyebrow="Diensten"
    title="Aanvullende diensten"
    intro={additionalServices.intro}
    crumbs={[{ label: 'Diensten', href: '/diensten' }, { label: 'Aanvullende diensten' }]}
  />

  <section class="section">
    <div class="container max-w-content grid sm:grid-cols-2 gap-6">
      {additionalServices.items.map((item) => (
        <div class="card p-8">
          <h2 class="font-display text-xl font-semibold text-ink-900">{item.title}</h2>
          <p class="mt-3 text-ink-600 leading-relaxed">{item.description}</p>
          <a href={item.href} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:gap-2.5 transition-all">
            {item.linkLabel}
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.02-1.1l5 4.25a.75.75 0 0 1 0 1.18l-5 4.25a.75.75 0 1 1-1.02-1.1l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" /></svg>
          </a>
        </div>
      ))}
    </div>
  </section>

  <CTASection />
</BaseLayout>
