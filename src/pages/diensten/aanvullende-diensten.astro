---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CTASection from '@/components/CTASection.astro';
import { additionalServices } from '@/data/services';

const arrow = '<svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.02-1.1l5 4.25a.75.75 0 0 1 0 1.18l-5 4.25a.75.75 0 1 1-1.02-1.1l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" /></svg>';
---

<BaseLayout
  title="Aanvullende diensten"
  description="Naast accountancy, belastingadvies en loonadministratie biedt Avydo een kenniscentrum en een persoonlijk secretariaat."
  path="/diensten/aanvullende-diensten"
>
  <PageHero
    eyebrow="Diensten"
    title="Aanvullende diensten"
    intro={additionalServices.intro}
    crumbs={[{ label: 'Diensten', href: '/diensten' }, { label: 'Aanvullende diensten' }]}
  />

  <section class="section">
    <div class="container max-w-content">
      <div class="border-t border-ink-200">
        {additionalServices.items.map((item, i) => (
          <a href={item.href} class="group flex flex-col gap-3 border-b border-ink-200 py-8 sm:flex-row sm:items-center sm:justify-between sm:gap-8" data-reveal="fade" style={`--stagger-delay:${i * 100}ms`}>
            <div>
              <h2 class="font-display text-2xl font-semibold text-ink-900 transition-colors group-hover:text-brand-600">{item.title}</h2>
              <p class="mt-2 max-w-xl leading-relaxed text-ink-600">{item.description}</p>
            </div>
            <span class="link-draw inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-brand-600">
              {item.linkLabel}
              <Fragment set:html={arrow} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
