---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTASection from '@/components/CTASection.astro';
import ArticleCard from '@/components/kenniscentrum/ArticleCard.astro';
import { formatDate, audienceLabels } from '@/lib/kenniscentrum';
import { safeJsonLd } from '@/lib/seo';
import { dateIsSourceLastModified, hasOwnRelevance, OUTDATED_STATUSES, STATUS_LABELS } from '@/lib/news-presentation.mjs';

export async function getStaticPaths() {
  const articles = await getCollection('kenniscentrum', ({ data }) => !data.hidden);
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article, allArticles: articles },
  }));
}

const { article, allArticles } = Astro.props;
const { title, category, priority, publishedAt, updatedAt, sourcePublishedAt, sourceName, sourceUrl, summary, relevance, audiences, status, supersededBy, avydoContent } = article.data;

// Elk zichtbaar artikel is een Avydo-artikel met een eigen tekst. Alleen als
// die tekst niet meer is dan de samenvatting, tonen we hem niet apart.
const { Content } = await render(article);
const hasExtendedBody = article.body != null && article.body.trim().length > summary.length * 1.3;
// Sjabloonteksten van de nieuwsengine zijn geen eigen uitleg: niet tonen.
const showRelevance = hasOwnRelevance(relevance);
const statusLabel = status ? STATUS_LABELS[status] : undefined;
const isOutdated = Boolean(supersededBy) || (status != null && OUTDATED_STATUSES.has(status));
const successor = supersededBy ? allArticles.find((a) => a.data.sourceUrl === supersededBy) : undefined;
// Bij de omgezette KVK-artikelen is de datum de "laatst gewijzigd"-datum van
// de bronpagina, geen publicatiedatum.
const dateIsLastModified = dateIsSourceLastModified(article.data);
// Datum van het officiële bronbericht, als die bekend is.
const sourceDate = sourcePublishedAt;
// De eigen publicatiedatum van Avydo tonen we apart als die afwijkt van de
// datum van het bronbericht. Bij de in oktober 2026 omgezette artikelen is
// `publishedAt` de datum van het bronbericht gebleven; daar tonen we alleen
// die datum en de datum van de omzetting (updatedAt).
const sameDay = (a: Date, b: Date) => a.toISOString().slice(0, 10) === b.toISOString().slice(0, 10);
const showAvydoDate = !dateIsLastModified && !(sourceDate && sameDay(sourceDate, publishedAt));
// Bronnaam in een lopende zin ("informatie van de Belastingdienst").
const sourceInSentence = sourceName === 'Belastingdienst' || sourceName === 'Rijksoverheid' ? `de ${sourceName}` : sourceName;

const related = allArticles
  .filter((a) => a.slug !== article.slug && a.data.category === category)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const description = summary.length > 155 ? `${summary.slice(0, 152)}…` : summary;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: { '@type': 'Organization', name: 'Avydo Accountants & Belastingadviseurs' },
  publisher: { '@type': 'Organization', name: 'Avydo Accountants & Belastingadviseurs' },
  isBasedOn: {
    '@type': 'CreativeWork',
    url: sourceUrl,
    publisher: { '@type': 'Organization', name: sourceName },
    ...(sourcePublishedAt ? { datePublished: sourcePublishedAt.toISOString() } : {}),
  },
  articleSection: category,
};
---

<BaseLayout title={title} description={description} path={`/kenniscentrum/${article.slug}`}>
  <script type="application/ld+json" set:html={safeJsonLd(structuredData)} slot="head" />

  <section class="bg-ink-950 text-white">
    <div class="container max-w-content py-16 md:py-20">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-1.5 text-xs text-ink-300">
          <li><a href="/" class="hover:text-white">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/kenniscentrum" class="hover:text-white">Kenniscentrum</a></li>
          <li aria-hidden="true">/</li>
          <li><span class="text-white">{category}</span></li>
        </ol>
      </nav>
      <div class="flex items-center gap-2 flex-wrap">
        {statusLabel && (
          <span class="inline-flex items-center rounded-full border border-white/25 px-2.5 py-0.5 text-xs font-semibold text-white" data-status={status}>{statusLabel}</span>
        )}
        {priority === 'belangrijk' && !isOutdated && (
          <span class="inline-flex items-center rounded-full bg-brand-500/20 px-2.5 py-0.5 text-xs font-semibold text-brand-300">Belangrijk</span>
        )}
        <span class="text-xs font-medium text-ink-300">{category}</span>
        <span class="text-xs text-ink-500">&middot;</span>
        <span class="text-xs text-ink-300">{dateIsLastModified && 'Bron bijgewerkt '}<time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time></span>
      </div>
      <div class="mask-reveal mt-4 overflow-hidden" data-reveal="mask">
        <h1 class="mask-reveal-inner max-w-3xl pb-1 font-display text-3xl font-semibold leading-[1.1] text-white md:text-4xl">{title}</h1>
      </div>
      {audiences.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {audiences.map((a) => (
            <span class="inline-flex items-center rounded-full bg-white/10 px-2.5 py-0.5 text-xs font-medium text-ink-100">
              {audienceLabels[a] ?? a}
            </span>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container max-w-content grid lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 max-w-2xl">
        {isOutdated && (
          <div class="mb-8 rounded-md border-l-4 border-ink-400 bg-ink-50 px-4 py-3 text-sm text-ink-700 leading-relaxed" role="note" data-outdated-notice>
            <strong class="text-ink-900">{statusLabel ?? 'Historisch'} artikel.</strong> Dit artikel beschrijft de situatie ten tijde van het bronbericht{sourceDate && <> van {formatDate(sourceDate)}</>}; die is inmiddels niet meer (volledig) actueel.
            {successor ? (
              <> Lees ook: <a href={`/kenniscentrum/${successor.slug}`} class="font-semibold text-brand-600 hover:underline">{successor.data.title}</a>.</>
            ) : supersededBy ? (
              <> Lees ook het <a href={supersededBy} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-600 hover:underline">latere bericht bij de bron</a>.</>
            ) : null}
          </div>
        )}

        <h2 class="text-lg font-display font-semibold text-ink-900">Samenvatting</h2>
        <p class="mt-3 text-ink-700 leading-relaxed text-lg">{summary}</p>

        {showRelevance && (
          <div class="mt-8 rounded-md border border-ink-100 bg-ink-50/60 p-6">
            <h2 class="font-display text-lg font-semibold text-ink-900">Wat betekent dit voor uw onderneming?</h2>
            <p class="mt-2 text-ink-700 leading-relaxed">{relevance}</p>
          </div>
        )}

        {hasExtendedBody && (
          <div class="prose prose-slate mt-10 max-w-none prose-headings:font-display prose-headings:text-ink-900 prose-h2:text-xl prose-h2:mt-8 prose-a:text-brand-600 prose-strong:text-ink-900">
            <Content />
          </div>
        )}

        <div class="mt-8 rounded-md border border-ink-100 p-6" data-source-block>
          <h2 class="font-display text-base font-semibold text-ink-900">Officiële bron</h2>
          <p class="mt-2 text-sm text-ink-600 leading-relaxed">
            {avydoContent === 'gids' ? (
              <>Deze gids is geschreven door Avydo op basis van informatie van <strong class="text-ink-800">{sourceInSentence}</strong>.</>
            ) : (
              <>Deze toelichting is geschreven door Avydo op basis van een bericht van <strong class="text-ink-800">{sourceInSentence}</strong>{sourceDate && <> van {formatDate(sourceDate)}</>}.</>
            )}
            {dateIsLastModified && <> Volgens {sourceName} is de bronpagina voor het laatst bijgewerkt op {formatDate(publishedAt)}.</>}
            {' '}U leest hier de uitleg van Avydo, niet de tekst van de bron zelf. Voor de volledige, officiële regels is de bron leidend.
          </p>
          <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:underline">
            {`Bekijk de bron bij ${sourceInSentence}`}
            <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M4.5 4A1.5 1.5 0 0 0 3 5.5v10A1.5 1.5 0 0 0 4.5 17h10a1.5 1.5 0 0 0 1.5-1.5V11a.75.75 0 0 0-1.5 0v4.5h-10v-10H9A.75.75 0 0 0 9 4H4.5Zm6.75.75c0 .414.336.75.75.75h2.69l-6.22 6.22a.75.75 0 1 0 1.06 1.06l6.22-6.22v2.69a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0-.75.75Z"/></svg>
          </a>
        </div>

        <p class="mt-6 text-xs text-ink-500 leading-relaxed">
          Dit artikel is door Avydo met zorg geschreven op basis van de bovengenoemde officiële bron en is bedoeld als algemene informatie. Het vormt geen fiscaal of juridisch advies. Voor advies toegespitst op uw situatie kunt u <a href="/contact" class="underline hover:text-brand-600">contact opnemen met Avydo</a>.
        </p>
      </div>

      <aside>
        <div class="card p-6">
          <h2 class="font-display text-lg font-semibold text-ink-900">In het kort</h2>
          <dl class="mt-4 space-y-3 text-sm">
            {statusLabel && (
              <div class="flex justify-between gap-4"><dt class="text-ink-600">Status</dt><dd class="font-semibold text-ink-900">{statusLabel}</dd></div>
            )}
            <div class="flex justify-between gap-4"><dt class="text-ink-600">Categorie</dt><dd class="font-semibold text-ink-900">{category}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-ink-600">Auteur</dt><dd class="font-semibold text-ink-900 text-right">Avydo</dd></div>
            {showAvydoDate && (
              <div class="flex justify-between gap-4"><dt class="text-ink-600">Gepubliceerd</dt><dd class="font-semibold text-ink-900">{formatDate(publishedAt)}</dd></div>
            )}
            {updatedAt && (
              <div class="flex justify-between gap-4"><dt class="text-ink-600">Bijgewerkt</dt><dd class="font-semibold text-ink-900">{formatDate(updatedAt)}</dd></div>
            )}
            <div class="flex justify-between gap-4"><dt class="text-ink-600">Officiële bron</dt><dd class="font-semibold text-ink-900 text-right"><a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="hover:text-brand-600">{sourceName}</a></dd></div>
            {sourceDate && (
              <div class="flex justify-between gap-4"><dt class="text-ink-600">Datum bronbericht</dt><dd class="font-semibold text-ink-900">{formatDate(sourceDate)}</dd></div>
            )}
            {dateIsLastModified && (
              <div class="flex justify-between gap-4"><dt class="text-ink-600">{`Bron bijgewerkt bij ${sourceName}`}</dt><dd class="font-semibold text-ink-900">{formatDate(publishedAt)}</dd></div>
            )}
          </dl>
          <a href="/kenniscentrum" class="btn-outline mt-6 w-full">Naar het kenniscentrum</a>
        </div>

        <div class="card p-6 mt-6 bg-ink-900 border-ink-800">
          <h2 class="font-display text-base font-semibold text-white">Heeft u hier nog een vraag over?</h2>
          <p class="mt-2 text-sm text-ink-300 leading-relaxed">Onze AI-assistent gebruikt dit artikel als context voor uw vraag.</p>
          <a href={`/kenniscentrum/ai-assistent?artikel=${article.slug}`} class="btn-ghost-light mt-4 w-full">Vraag het aan onze AI-assistent</a>
        </div>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section bg-ink-50/60 border-y border-ink-100">
      <div class="container max-w-content">
        <p class="eyebrow">Ook interessant</p>
        <h2 class="mt-3 text-2xl font-display font-semibold text-ink-900">Gerelateerde artikelen</h2>
        <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {related.map((a) => <ArticleCard article={a} />)}
        </div>
      </div>
    </section>
  )}

  <CTASection />
</BaseLayout>
