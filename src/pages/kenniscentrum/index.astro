---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CTASection from '@/components/CTASection.astro';
import ArticleCard from '@/components/kenniscentrum/ArticleCard.astro';
import { audienceOptions, pickHighlighted } from '@/lib/kenniscentrum';
import { isReferenceArticle } from '@/lib/news-presentation.mjs';
import { resourceLinks } from '@/data/links';
import { company } from '@/data/company';

const INITIAL_VISIBLE = 9;

const allArticles = await getCollection('kenniscentrum', ({ data }) => !data.hidden);
allArticles.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const categories = [...new Set(allArticles.map((a) => a.data.category))].sort();
const bronnen = [...new Set(allArticles.map((a) => a.data.sourceName))].sort();

// Nieuws en naslag (evergreen uitleg) worden apart getoond, zodat naslag
// met een recente wijzigingsdatum niet bovenaan "Laatste nieuws" belandt.
const newsArticles = allArticles.filter((a) => !isReferenceArticle(a.data));
const highlighted = pickHighlighted(newsArticles, 4);
// Eerste reeks zonder JavaScript: de nieuwste nieuwsberichten (gelijk aan de
// standaardweergave van het filterscript).
const initiallyVisible = new Set(newsArticles.slice(0, INITIAL_VISIBLE).map((a) => a.id));

---

<BaseLayout
  title="Kenniscentrum"
  description="Het kenniscentrum van Avydo verzamelt actuele ontwikkelingen in belastingen, accountancy, personeel en ondernemerschap die relevant zijn voor Nederlandse mkb-ondernemers. Filter op onderwerp, bron of uw situatie als ondernemer."
  path="/kenniscentrum"
>
  <PageHero
    eyebrow="Kenniscentrum"
    title="Actuele ontwikkelingen voor mkb-ondernemers"
    intro="Avydo houdt hier actuele ontwikkelingen bij op het gebied van belastingen, accountancy, personeel en ondernemerschap, uit officiële bronnen zoals de Rijksoverheid, de Belastingdienst en KVK. Waar Avydo een eigen toelichting heeft toegevoegd, leest u wat dit voor uw onderneming kan betekenen; elk artikel verwijst naar de oorspronkelijke bron."
    crumbs={[{ label: 'Kenniscentrum' }]}
  />

  {allArticles.length === 0 ? (
    <section class="section">
      <div class="container max-w-content">
        <div class="rounded-md border border-dashed border-ink-300 bg-ink-50/60 p-8 md:p-10 text-center max-w-3xl mx-auto">
          <p class="eyebrow">Binnenkort</p>
          <h2 class="mt-3 text-2xl font-display font-semibold text-ink-900">Actuele artikelen van Avydo</h2>
          <p class="mt-3 text-ink-600 leading-relaxed">
            Ons systeem verzamelt automatisch relevante ontwikkelingen van officiële bronnen zoals de Belastingdienst en de Rijksoverheid. De eerste artikelen verschijnen hier zodra dat proces heeft gedraaid. Heeft u nu al een vraag? Neem gerust contact met ons op via <a href={`mailto:${company.email}`} class="font-semibold text-brand-600 hover:underline">{company.email}</a> of <a href={company.phoneHref} class="font-semibold text-brand-600 hover:underline">{company.phone}</a>.
          </p>
        </div>
      </div>
    </section>
  ) : (
    <>
      <section class="section pb-0">
        <div class="container max-w-content">
          <div class="rounded-md border border-ink-100 bg-white p-5 md:p-6">
            <h2 id="kc-audience-heading" class="text-sm font-semibold text-ink-900">Waar bent u vooral mee bezig?</h2>
            <p class="mt-1 text-xs text-ink-500">Kies uw situatie en we laten relevante artikelen duidelijker naar voren komen. Er wordt niets opgeslagen en er is geen tracking.</p>
            <div class="mt-3 flex flex-wrap gap-2" role="group" aria-labelledby="kc-audience-heading" id="kc-audience-filters">
              <button type="button" data-audience-filter="" class="filter-chip is-active" aria-pressed="true">Geen voorkeur</button>
              {audienceOptions.map((opt) => (
                <button type="button" data-audience-filter={opt.value} class="filter-chip" aria-pressed="false">{opt.label}</button>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="section pb-0">
        <div class="container max-w-content">
          <div class="grid sm:grid-cols-2 gap-5">
            <div class="rounded-lg border border-brand-200 bg-brand-50 p-5 md:p-6 flex flex-col h-full">
              <p class="eyebrow">Nieuw in het Kenniscentrum</p>
              <h2 class="mt-1 text-lg font-display font-semibold text-ink-900">Belastingkalender</h2>
              <p class="mt-1 text-sm text-ink-600 leading-relaxed flex-1">Bekijk in één oogopslag de eerstvolgende btw-, loonheffingen- en vennootschapsbelastingdeadlines voor uw onderneming.</p>
              <a href="/belastingkalender" class="btn-primary mt-4 self-start">Bekijk de belastingkalender</a>
            </div>
            <div class="rounded-lg border border-ink-800 bg-ink-900 p-5 md:p-6 flex flex-col h-full">
              <p class="eyebrow text-brand-300">Een fiscale of financiële vraag?</p>
              <h2 class="mt-1 text-lg font-display font-semibold text-white">Stel uw vraag aan onze AI-assistent</h2>
              <p class="mt-1 text-sm text-ink-300 leading-relaxed flex-1">Krijg direct een antwoord op basis van het Kenniscentrum en officiële bronnen, met bronvermelding.</p>
              <a href="/kenniscentrum/ai-assistent" class="btn-ghost-light mt-4 self-start">Stel uw vraag</a>
            </div>
          </div>
        </div>
      </section>

      {highlighted.length > 0 && (
        <section class="section pb-0">
          <div class="container max-w-content">
            <p class="eyebrow">Uitgelicht</p>
            <div class="mask-reveal mt-3 overflow-hidden" data-reveal="mask">
              <h2 class="mask-reveal-inner pb-1 font-display text-2xl font-semibold leading-[1.1] text-ink-900 sm:text-3xl">Belangrijk voor ondernemers</h2>
            </div>
            <p class="mt-2 text-ink-600 leading-relaxed max-w-2xl">Een kleine selectie van actuele ontwikkelingen die voor veel ondernemers van belang zijn.</p>
            <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
              {highlighted.map((article) => (
                <ArticleCard article={article} highlighted />
              ))}
            </div>
          </div>
        </section>
      )}

      <section class="section">
        <div class="container max-w-content">
          <p class="eyebrow">Nieuws en naslag</p>
          <div class="mask-reveal mt-3 overflow-hidden" data-reveal="mask">
            <h2 class="mask-reveal-inner pb-1 font-display text-2xl font-semibold leading-[1.1] text-ink-900 sm:text-3xl">Laatste nieuws</h2>
          </div>
          <p class="mt-2 text-ink-600 leading-relaxed max-w-2xl">Nieuwste eerst. Onder <em>Naslag</em> vindt u uitleg over regels die langer gelden. Zoek of filter hieronder om snel te vinden wat voor u relevant is.</p>

          <div class="mt-6 lg:hidden">
            <button
              type="button"
              id="kc-filters-toggle"
              aria-expanded="false"
              aria-controls="kc-filters-panel"
              class="btn-outline w-full justify-between"
            >
              <span>Filters &amp; zoeken</span>
              <span id="kc-active-filter-count" class="text-xs text-ink-500"></span>
            </button>
          </div>

          <div id="kc-filters-panel" class="hidden lg:block mt-6 space-y-5">
            <div>
              <span class="block text-xs font-semibold uppercase tracking-wide text-ink-500 mb-2" id="kc-kind-heading">Soort</span>
              <div class="flex flex-wrap gap-2" role="group" aria-labelledby="kc-kind-heading" id="kind-filters">
                <button type="button" data-kind-filter="nieuws" class="filter-chip is-active" aria-pressed="true">Nieuws ({newsArticles.length})</button>
                <button type="button" data-kind-filter="naslag" class="filter-chip" aria-pressed="false">Naslag ({allArticles.length - newsArticles.length})</button>
                <button type="button" data-kind-filter="alles" class="filter-chip" aria-pressed="false">Alles</button>
              </div>
            </div>

            <div>
              <span class="block text-xs font-semibold uppercase tracking-wide text-ink-500 mb-2" id="kc-category-heading">Categorie</span>
              <div class="flex flex-wrap gap-2" role="group" aria-labelledby="kc-category-heading" id="category-filters">
                <button type="button" data-category-filter="" class="filter-chip is-active" aria-pressed="true">Alles</button>
                {categories.map((cat) => (
                  <button type="button" data-category-filter={cat} class="filter-chip" aria-pressed="false">{cat}</button>
                ))}
              </div>
            </div>

            <div>
              <span class="block text-xs font-semibold uppercase tracking-wide text-ink-500 mb-2" id="kc-source-heading">Bron</span>
              <div class="flex flex-wrap gap-2" role="group" aria-labelledby="kc-source-heading" id="source-filters">
                <button type="button" data-source-filter="" class="filter-chip is-active" aria-pressed="true">Alle bronnen</button>
                {bronnen.map((bron) => (
                  <button type="button" data-source-filter={bron} class="filter-chip" aria-pressed="false">{bron}</button>
                ))}
              </div>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center gap-3">
              <div class="relative flex-1 sm:max-w-xs">
                <label for="kc-search" class="sr-only">Zoeken in kenniscentrum</label>
                <input
                  type="search"
                  id="kc-search"
                  placeholder="Zoek op titel, samenvatting, categorie of bron&hellip;"
                  class="w-full rounded border border-ink-200 px-3.5 py-2.5 pl-9 text-sm text-ink-900 placeholder:text-ink-400 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors"
                />
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-ink-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.55 4.3l3.2 3.2a.75.75 0 1 1-1.06 1.06l-3.2-3.2A7 7 0 0 1 2 9Z" clip-rule="evenodd" /></svg>
              </div>
              <button type="button" id="kc-clear-filters" class="btn-outline shrink-0">Filters wissen</button>
            </div>
          </div>

          <p id="kc-results-count" class="mt-6 text-sm text-ink-500" aria-live="polite"></p>

          <p id="kc-empty" class="hidden mt-4 text-center text-ink-500 py-12">Geen artikelen gevonden. Probeer een andere zoekterm of wis uw filters.</p>

          <div id="kc-grid" data-initial-visible={INITIAL_VISIBLE} class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {allArticles.map((article) => (
              <div class:list={['kc-item', !initiallyVisible.has(article.id) && 'kc-extra hidden']}>
                <ArticleCard article={article} />
              </div>
            ))}
          </div>

          {allArticles.length > INITIAL_VISIBLE && (
            <div class="mt-8 text-center">
              <button type="button" id="kc-load-more" class="btn-outline">Toon meer artikelen</button>
            </div>
          )}
        </div>
      </section>
    </>
  )}

  <section class="section bg-paper-muted border-y border-ink-100">
    <div class="container max-w-content">
      <p class="eyebrow">Handige bronnen</p>
      <div class="mask-reveal mt-3 overflow-hidden" data-reveal="mask">
        <h2 class="mask-reveal-inner pb-1 font-display text-2xl font-semibold leading-[1.1] text-ink-900 sm:text-3xl">Betrouwbare informatie voor ondernemers</h2>
      </div>
      <p class="mt-3 text-ink-600 leading-relaxed max-w-2xl">Avydo vertrouwt op de volgende organisaties voor actuele en betrouwbare informatie.</p>
      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {resourceLinks.map((link, i) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" class="border border-ink-200 bg-white p-6 transition-colors hover:border-brand-300" data-reveal="fade" style={`--stagger-delay:${i * 80}ms`}>
            <h3 class="font-display font-semibold text-ink-900 flex items-center justify-between gap-2">
              {link.name}
              <svg class="h-4 w-4 shrink-0 text-ink-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M4.5 4A1.5 1.5 0 0 0 3 5.5v10A1.5 1.5 0 0 0 4.5 17h10a1.5 1.5 0 0 0 1.5-1.5V11a.75.75 0 0 0-1.5 0v4.5h-10v-10H9A.75.75 0 0 0 9 4H4.5Zm6.75.75c0 .414.336.75.75.75h2.69l-6.22 6.22a.75.75 0 1 0 1.06 1.06l6.22-6.22v2.69a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0-.75.75Z"/></svg>
            </h3>
            <p class="mt-2 text-sm text-ink-600 leading-relaxed">{link.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .filter-chip {
    @apply rounded-full border border-ink-200 px-3.5 py-1.5 text-sm font-medium text-ink-700 hover:border-brand-300 hover:text-brand-600 transition-colors;
  }
  .filter-chip.is-active {
    @apply border-brand-600 bg-brand-600 text-white hover:border-brand-600 hover:text-white;
  }
</style>

<script>
  const grid = document.getElementById('kc-grid');
  const initialVisible = Number(grid?.dataset.initialVisible ?? 9);
  const items = Array.from(document.querySelectorAll<HTMLElement>('.kc-item'));
  const emptyState = document.getElementById('kc-empty');
  const resultsCount = document.getElementById('kc-results-count');
  const loadMoreBtn = document.getElementById('kc-load-more');
  const searchInput = document.getElementById('kc-search') as HTMLInputElement | null;
  const categoryButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-filter]'));
  const sourceButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-source-filter]'));
  const audienceButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-audience-filter]'));
  const kindButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-kind-filter]'));
  const DEFAULT_KIND = 'nieuws';
  const clearFiltersBtn = document.getElementById('kc-clear-filters');
  const filtersToggle = document.getElementById('kc-filters-toggle');
  const filtersPanel = document.getElementById('kc-filters-panel');
  const activeFilterCountEl = document.getElementById('kc-active-filter-count');

  function resolveParam(buttons: HTMLButtonElement[], attr: string, value: string | null): string {
    if (!value) return '';
    return buttons.some((b) => b.dataset[attr] === value) ? value : '';
  }

  const initialParams = new URLSearchParams(window.location.search);
  let activeCategory = resolveParam(categoryButtons, 'categoryFilter', initialParams.get('categorie'));
  let activeSource = resolveParam(sourceButtons, 'sourceFilter', initialParams.get('bron'));
  let activeAudience = resolveParam(audienceButtons, 'audienceFilter', initialParams.get('doelgroep'));
  // Zonder eigen keuze toont het overzicht nieuws; bij zoeken of filteren
  // wordt in nieuws én naslag gezocht, zodat niets onvindbaar wordt.
  let activeKind = resolveParam(kindButtons, 'kindFilter', initialParams.get('soort'));
  let kindExplicit = Boolean(activeKind);
  if (!activeKind) activeKind = DEFAULT_KIND;
  const initialQuery = initialParams.get('q') ?? '';
  if (searchInput && initialQuery) searchInput.value = initialQuery;

  let showAll = false;

  function setActiveButton(buttons: HTMLButtonElement[], attr: string, value: string) {
    buttons.forEach((b) => {
      const isActive = (b.dataset[attr] ?? '') === value;
      b.classList.toggle('is-active', isActive);
      b.setAttribute('aria-pressed', String(isActive));
    });
  }

  function syncUrl() {
    const params = new URLSearchParams();
    if (activeCategory) params.set('categorie', activeCategory);
    if (activeSource) params.set('bron', activeSource);
    if (activeAudience) params.set('doelgroep', activeAudience);
    if (kindExplicit && activeKind !== DEFAULT_KIND) params.set('soort', activeKind);
    const query = searchInput?.value.trim() ?? '';
    if (query) params.set('q', query);
    const qs = params.toString();
    const newUrl = `${window.location.pathname}${qs ? `?${qs}` : ''}`;
    window.history.replaceState(null, '', newUrl);
  }

  function updateActiveFilterCount() {
    if (!activeFilterCountEl) return;
    const kindRefinement = kindExplicit && activeKind !== DEFAULT_KIND ? activeKind : '';
    const count = [activeCategory, activeSource, activeAudience, searchInput?.value.trim(), kindRefinement].filter(Boolean).length;
    activeFilterCountEl.textContent = count > 0 ? `${count} actief` : '';
  }

  function applyFilters() {
    const query = (searchInput?.value ?? '').trim().toLowerCase();
    const anyRefinement = Boolean(activeCategory) || Boolean(activeSource) || Boolean(query) || Boolean(activeAudience);
    const effectiveKind = kindExplicit || !(activeCategory || activeSource || query) ? activeKind : 'alles';
    setActiveButton(kindButtons, 'kindFilter', effectiveKind);
    let visibleCount = 0;
    let matchCount = 0;

    items.forEach((item) => {
      const article = item.querySelector('article');
      const category = article?.getAttribute('data-category') ?? '';
      const source = article?.getAttribute('data-source') ?? '';
      const title = article?.getAttribute('data-title') ?? '';
      const summary = article?.getAttribute('data-summary') ?? '';
      const tags = article?.getAttribute('data-tags') ?? '';
      const audiences = (article?.getAttribute('data-audiences') ?? '').split(' ').filter(Boolean);
      const kind = article?.getAttribute('data-kind') ?? 'nieuws';

      const matchesCategory = !activeCategory || category === activeCategory;
      const matchesSource = !activeSource || source === activeSource;
      const matchesQuery = !query
        || title.includes(query)
        || summary.includes(query)
        || category.toLowerCase().includes(query)
        || source.toLowerCase().includes(query)
        || tags.includes(query);
      const matchesKind = effectiveKind === 'alles' || kind === effectiveKind;
      const matches = matchesCategory && matchesSource && matchesQuery && matchesKind;
      if (matches) matchCount += 1;
      // Zonder verfijning eerst een eerste reeks per gekozen soort tonen.
      const withinInitialBatch = showAll || anyRefinement || matchCount <= initialVisible;

      const visible = matches && withinInitialBatch;
      item.classList.toggle('hidden', !visible);

      const audienceMatch = Boolean(activeAudience) && audiences.includes(activeAudience);
      const badge = article?.querySelector<HTMLElement>('[data-audience-badge]');
      badge?.classList.toggle('hidden', !audienceMatch);
      item.style.order = audienceMatch ? '-1' : '0';

      if (visible) visibleCount += 1;
    });

    emptyState?.classList.toggle('hidden', visibleCount > 0);
    if (loadMoreBtn) loadMoreBtn.style.display = anyRefinement || showAll || matchCount <= initialVisible ? 'none' : '';
    if (resultsCount) resultsCount.textContent = `${visibleCount} artikel${visibleCount === 1 ? '' : 'en'} gevonden`;

    updateActiveFilterCount();
    syncUrl();
  }

  setActiveButton(categoryButtons, 'categoryFilter', activeCategory);
  setActiveButton(sourceButtons, 'sourceFilter', activeSource);
  setActiveButton(audienceButtons, 'audienceFilter', activeAudience);

  kindButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeKind = btn.dataset.kindFilter ?? DEFAULT_KIND;
      kindExplicit = true;
      showAll = false;
      applyFilters();
    });
  });

  categoryButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.categoryFilter ?? '';
      setActiveButton(categoryButtons, 'categoryFilter', activeCategory);
      applyFilters();
    });
  });

  sourceButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeSource = btn.dataset.sourceFilter ?? '';
      setActiveButton(sourceButtons, 'sourceFilter', activeSource);
      applyFilters();
    });
  });

  audienceButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeAudience = btn.dataset.audienceFilter ?? '';
      setActiveButton(audienceButtons, 'audienceFilter', activeAudience);
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', applyFilters);

  loadMoreBtn?.addEventListener('click', () => {
    showAll = true;
    applyFilters();
  });

  clearFiltersBtn?.addEventListener('click', () => {
    activeCategory = '';
    activeSource = '';
    activeAudience = '';
    activeKind = DEFAULT_KIND;
    kindExplicit = false;
    if (searchInput) searchInput.value = '';
    setActiveButton(categoryButtons, 'categoryFilter', '');
    setActiveButton(sourceButtons, 'sourceFilter', '');
    setActiveButton(audienceButtons, 'audienceFilter', '');
    applyFilters();
  });

  filtersToggle?.addEventListener('click', () => {
    const isOpen = !filtersPanel?.classList.contains('hidden');
    filtersPanel?.classList.toggle('hidden', isOpen);
    filtersToggle.setAttribute('aria-expanded', String(!isOpen));
  });

  applyFilters();
</script>
