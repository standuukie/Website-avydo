---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroGraphic from '@/components/HeroGraphic.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import FAQAccordion from '@/components/FAQAccordion.astro';
import CTASection from '@/components/CTASection.astro';
import { services } from '@/data/services';
import { testimonials } from '@/data/testimonials';
import { company } from '@/data/company';

const faqs = [
  {
    question: 'Voor wie is Avydo geschikt?',
    answer: 'Avydo richt zich op het mkb: ondernemers en DGA’s die behoefte hebben aan een vaste, betrokken partner naast een correcte administratieve afhandeling. Van eenmanszaak tot familiebedrijf.',
  },
  {
    question: 'Wat maakt Avydo anders dan een groter accountantskantoor?',
    answer: 'Avydo biedt dezelfde kwaliteit als grotere kantoren, maar dan met een gunstigere prijsstelling, een informele sfeer en een vast aanspreekpunt dat uw onderneming daadwerkelijk kent.',
  },
  {
    question: 'In welke regio is Avydo actief?',
    answer: `Avydo bedient ondernemers in en rond ${company.region.join(', ')}.`,
  },
  {
    question: 'Is Avydo als accountantskantoor getoetst?',
    answer: 'Ja. In december 2017 heeft de Koninklijke Nederlandse Beroepsorganisatie van Accountants (NBA) een kwaliteitstoetsing bij Avydo uitgevoerd. Daaruit bleek dat Avydo voldoet aan het bepaalde bij of krachtens de Wet op het accountantsberoep.',
  },
  {
    question: 'Hoe maak ik een afspraak met Avydo?',
    answer: `U kunt bellen naar ${company.phone}, mailen naar ${company.email} of het contactformulier invullen. Wij nemen dan snel contact met u op om een kennismakingsgesprek in te plannen.`,
  },
];
---

<BaseLayout
  title="Accountant in Venray | Avydo Accountants & Belastingadviseurs"
  description="Avydo is uw accountant in Venray voor mkb-ondernemers in Vierlingsbeek, Horst-Sevenum en Nieuw-Bergen. Accountancy, belastingadvies en loonadministratie onder één dak, met een vast aanspreekpunt."
  path="/"
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-ink-900 text-white">
    <div class="container max-w-content py-16 md:py-24 grid lg:grid-cols-2 gap-12 items-center">
      <div class="animate-fade-up">
        <p class="eyebrow text-brand-300">Accountant &amp; belastingadviseur in Venray</p>
        <h1 class="mt-4 text-4xl md:text-[3.25rem] leading-[1.1] font-display font-semibold text-white">
          Een ervaren accountant die uw onderneming écht begrijpt
        </h1>
        <p class="mt-6 text-lg text-ink-200 leading-relaxed max-w-xl">
          Wet- en regelgeving wordt er niet eenvoudiger op, en ondernemen is al complex genoeg. Avydo is uw vaste partner in bedrijfsvoering in Venray en omstreken &mdash; met accountancy, belastingadvies en loonadministratie onder één dak.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href="/contact" class="btn-primary">Maak een afspraak</a>
          <a href="/diensten" class="btn-ghost-light">Bekijk onze diensten</a>
        </div>
        <dl class="mt-10 grid grid-cols-3 gap-6 max-w-md border-t border-ink-700 pt-6">
          <div>
            <dt class="text-xs uppercase tracking-wide text-ink-300">Sinds</dt>
            <dd class="mt-1 font-display text-xl font-semibold text-white">2006</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-ink-300">Team</dt>
            <dd class="mt-1 font-display text-xl font-semibold text-white">10 professionals</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-ink-300">Getoetst door</dt>
            <dd class="mt-1 font-display text-xl font-semibold text-white">NBA</dd>
          </div>
        </dl>
      </div>
      <div class="hidden lg:block">
        <HeroGraphic />
      </div>
    </div>
  </section>

  <!-- WAARDEPROPOSITIE -->
  <section class="section">
    <div class="container max-w-content grid lg:grid-cols-3 gap-10">
      <div class="lg:col-span-1">
        <p class="eyebrow">Waarom Avydo</p>
        <h2 class="mt-3 text-3xl font-display font-semibold text-ink-900">Duidelijkheid en overzicht, zodat u kunt ondernemen</h2>
      </div>
      <div class="lg:col-span-2 text-ink-600 leading-relaxed space-y-4 text-lg">
        <p>
          Elke ondernemer krijgt te maken met ingewikkelde wet- en regelgeving, terwijl het ondernemen zelf al complex genoeg is. Avydo Accountants &amp; Belastingadviseurs is daarom uw partner in bedrijfsvoering: wij zorgen voor duidelijkheid en overzicht, zodat u zich volledig kunt richten op uw rol als ondernemer.
        </p>
        <p>
          Wij voldoen aan de hoge eisen van de Koninklijke Nederlandse Beroepsorganisatie van Accountants (NBA), zodat u erop kunt vertrouwen dat ons werk correct wordt uitgevoerd.
        </p>
      </div>
    </div>
  </section>

  <!-- DIENSTEN -->
  <section class="section bg-ink-50/60 border-y border-ink-100">
    <div class="container max-w-content">
      <div class="max-w-2xl">
        <p class="eyebrow">Onze diensten</p>
        <h2 class="mt-3 text-3xl md:text-4xl font-display font-semibold text-ink-900">Een compleet dienstenpakket, onder één dak</h2>
        <p class="mt-4 text-ink-600 leading-relaxed">
          Van jaarrekening tot loonstrook: Avydo biedt mkb-ondernemers in de regio Venray alles wat nodig is voor een gezonde bedrijfsvoering.
        </p>
      </div>
      <div class="mt-10 grid md:grid-cols-3 gap-6">
        {services.map((service, i) => (
          <ServiceCard name={service.name} description={service.short} href={`/diensten/${service.slug}`} index={i} />
        ))}
      </div>
      <div class="mt-8">
        <a href="/diensten/aanvullende-diensten" class="text-sm font-semibold text-ink-800 hover:text-brand-600 inline-flex items-center gap-1.5">
          Bekijk ook onze aanvullende diensten
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.02-1.1l5 4.25a.75.75 0 0 1 0 1.18l-5 4.25a.75.75 0 1 1-1.02-1.1l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ONDERSCHEIDEND VERMOGEN -->
  <section class="section">
    <div class="container max-w-content">
      <div class="max-w-2xl mx-auto text-center">
        <p class="eyebrow">Wat u van ons mag verwachten</p>
        <h2 class="mt-3 text-3xl font-display font-semibold text-ink-900">Een hoogwaardig kantoor met een persoonlijke aanpak</h2>
      </div>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          {
            title: 'Vast aanspreekpunt',
            text: 'U krijgt uw eigen relatiebeheerder, die samen met u uw bedrijfsvoering analyseert en écht meedenkt.',
          },
          {
            title: 'Ondernemersperspectief',
            text: 'Onze partners zijn zelf ondernemer geweest en adviseren vanuit die praktijkervaring.',
          },
          {
            title: 'Kwaliteit van een groot kantoor',
            text: 'Avydo biedt dezelfde kwaliteit als grotere accountantskantoren, tegen een gunstigere prijsstelling.',
          },
          {
            title: 'NBA-getoetst',
            text: 'Onze kwaliteitsbeheersing is getoetst door de NBA en voldoet aan de Wet op het accountantsberoep.',
          },
        ].map((f) => (
          <div class="rounded-md border border-ink-100 p-6 hover:border-brand-300 transition-colors">
            <div class="h-9 w-9 rounded bg-brand-50 flex items-center justify-center">
              <svg class="h-5 w-5 text-brand-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.2a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/></svg>
            </div>
            <h3 class="mt-4 font-display font-semibold text-ink-900">{f.title}</h3>
            <p class="mt-2 text-sm text-ink-600 leading-relaxed">{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WERKWIJZE -->
  <section class="section bg-ink-900 text-white">
    <div class="container max-w-content">
      <div class="max-w-2xl">
        <p class="eyebrow text-brand-300">Zo werkt het</p>
        <h2 class="mt-3 text-3xl font-display font-semibold text-white">Van eerste gesprek tot vaste partner</h2>
      </div>
      <div class="mt-12 grid md:grid-cols-3 gap-8">
        {[
          { step: '01', title: 'Kennismakingsgesprek', text: 'We bespreken vrijblijvend uw situatie, uw onderneming en waar u tegenaan loopt.' },
          { step: '02', title: 'Analyse & vast aanspreekpunt', text: 'Uw relatiebeheerder analyseert samen met u uw bedrijfsvoering en stelt een aanpak voor.' },
          { step: '03', title: 'Doorlopend advies', text: 'U kunt blijvend rekenen op advies en uitvoering, met één vast aanspreekpunt.' },
        ].map((s) => (
          <div>
            <span class="font-display text-3xl font-semibold text-brand-400">{s.step}</span>
            <h3 class="mt-3 font-display text-xl font-semibold text-white">{s.title}</h3>
            <p class="mt-2 text-ink-300 leading-relaxed text-sm">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VERTROUWEN / TESTIMONIALS -->
  <section class="section">
    <div class="container max-w-content">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
        <div>
          <p class="eyebrow">Wat klanten zeggen</p>
          <h2 class="mt-3 text-3xl font-display font-semibold text-ink-900">De mening van ondernemers</h2>
        </div>
        <a href="/referenties" class="text-sm font-semibold text-ink-800 hover:text-brand-600 inline-flex items-center gap-1.5 shrink-0">
          Bekijk meer referenties
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.02-1.1l5 4.25a.75.75 0 0 1 0 1.18l-5 4.25a.75.75 0 1 1-1.02-1.1l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" /></svg>
        </a>
      </div>
      <div class="mt-10 grid md:grid-cols-3 gap-6">
        {testimonials.map((t) => <TestimonialCard {...t} />)}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-ink-50/60 border-y border-ink-100">
    <div class="container max-w-content">
      <div class="max-w-3xl">
        <p class="eyebrow">Veelgestelde vragen</p>
        <h2 class="mt-3 text-3xl font-display font-semibold text-ink-900">Nog vragen?</h2>
        <div class="mt-8">
          <FAQAccordion items={faqs} />
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
