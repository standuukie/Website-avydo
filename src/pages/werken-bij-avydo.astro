---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CTASection from '@/components/CTASection.astro';
import { jobs, applyAddress, internships } from '@/data/jobs';
import { company } from '@/data/company';
---

<BaseLayout
  title="Werken bij Avydo"
  description="Bekijk de vacatures bij Avydo Accountants & Belastingadviseurs in Venray, of solliciteer open. Ook stagiairs zijn welkom."
  path="/werken-bij-avydo"
>
  <PageHero
    eyebrow="Werken bij Avydo"
    title="Kom jij ons team versterken?"
    intro="Avydo heeft een sterk team in huis. Dat betekent niet dat er geen ruimte is voor nieuwe versterkingen. Ben jij van mening dat je een meerwaarde voor Avydo bent of kan worden? Reageer op onderstaande vacatures. Open sollicitaties worden ook serieus bekeken."
    crumbs={[{ label: 'Werken bij Avydo' }]}
  />

  <section class="section">
    <div class="container max-w-content">
      <div class="border-t border-ink-200">
        {jobs.map((job, i) => (
          <div class="border-b border-ink-200 py-10" data-reveal="fade" style={`--stagger-delay:${i * 100}ms`}>
            <div class="flex flex-wrap items-center gap-3">
              <h2 class="font-display text-2xl font-semibold text-ink-900">{job.title}</h2>
              <span class="eyebrow text-xs">{job.type}</span>
            </div>
            <p class="mt-4 max-w-2xl text-ink-600 leading-relaxed">{job.intro}</p>
            <h3 class="mt-6 text-sm font-semibold text-ink-800 uppercase tracking-wide">Takenpakket</h3>
            <ul class="mt-3 space-y-2">
              {job.tasks.map((t) => (
                <li class="flex gap-3 items-start text-sm text-ink-600 leading-relaxed">
                  <svg class="h-4 w-4 mt-1 shrink-0 text-brand-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.2a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/></svg>
                  {t}
                </li>
              ))}
            </ul>
            <p class="mt-5 text-sm text-ink-500">Solliciteren kan t.a.v. {job.contact}. Zie de contactgegevens hieronder.</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-paper-muted border-y border-ink-100">
    <div class="container max-w-content grid lg:grid-cols-2 gap-10">
      <div>
        <h2 class="font-display text-xl font-semibold text-ink-900">Solliciteren</h2>
        <p class="mt-3 text-ink-600 leading-relaxed">
          Stuur een sollicitatiebrief met cv naar <a href={`mailto:${company.email}`} class="font-semibold text-brand-600 hover:underline">{company.email}</a>, of per post naar:
        </p>
        <address class="mt-3 not-italic text-ink-700 leading-relaxed">
          {applyAddress.line1}<br />
          {applyAddress.line2}<br />
          {applyAddress.line3}<br />
          {applyAddress.line4}
        </address>
      </div>
      <div class="lg:border-l lg:border-ink-200 lg:pl-10">
        <h2 class="font-display text-xl font-semibold text-ink-900">Stage lopen bij Avydo</h2>
        <p class="mt-3 text-ink-600 leading-relaxed">{internships.intro}</p>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
