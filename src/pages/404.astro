---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { company } from '@/data/company';
---

<BaseLayout
  title="Pagina niet gevonden"
  description="De pagina die u zoekt bestaat niet (meer)."
  path="/404"
  noindex={true}
>
  <section class="section min-h-[60vh] flex items-center">
    <div class="container max-w-content text-center">
      <p class="eyebrow">Foutcode 404</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-display font-semibold text-ink-900">Deze pagina bestaat niet</h1>
      <p class="mt-4 text-ink-600 leading-relaxed max-w-xl mx-auto">
        Mogelijk is de pagina verplaatst of bestaat de link niet meer. Ga terug naar de homepage, of neem contact met ons op via {company.phone}.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3">
        <a href="/" class="btn-primary">Naar de homepage</a>
        <a href="/contact" class="btn-outline">Contact opnemen</a>
      </div>
    </div>
  </section>
</BaseLayout>
